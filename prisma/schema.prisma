// Prisma schema — Fase 1 (cimientos) de PREOPERACIONAL SEGURIDAD VIAL (ESS LTDA).
//
// Reglas de negocio inmutables reflejadas aquí (ver brief del proyecto):
// - Ninguna inspección se borra: no hay campo deletedAt ni mutation delete.
// - Los timestamps oficiales (startedAt, completedAt, approvedAt, rejectedAt,
//   reviewedAt) se generan SIEMPRE en el servidor (`now()` / `new Date()`),
//   nunca se reciben del cliente como valor de confianza.
// - No hay ninguna restricción de ventana horaria para iniciar una inspección.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TRABAJADOR
  SUPERVISOR
  DIRECTOR
  SST
  // Administra usuarios y el vehículo de cada trabajador (crear, editar,
  // restablecer contraseñas) — ver app/(admin)/**. Acceso de solo lectura a
  // dashboard/consulta-inspecciones para visibilidad operativa; no opera
  // como TRABAJADOR ni decide como SUPERVISOR (rompería la trazabilidad de
  // quién hizo cada acción).
  ADMINISTRADOR
}

enum InspectionStatus {
  EN_PROCESO
  ENVIADA
  PENDIENTE_APROBACION
  APROBADA
  RECHAZADA
  NO_APTA_PARA_OPERAR
  // Trabajador descarta una inspección EN_PROCESO que no va a terminar (ver
  // cancelarInspeccion, lib/inspections/actions.ts). No es un borrado: la
  // regla de inmutabilidad del proyecto sigue intacta, el registro queda en
  // la base — solo deja de aparecer como "En proceso".
  CANCELADA
}

// Fase 2: respuesta de un ítem de checklist dentro de una inspección.
// Formato oficial FO-SVS-23: binario (✓ OK / X FALLA-DAÑO-FALTANTE), no hay
// una tercera opción N/A en el formato real de la empresa.
enum RespuestaChecklist {
  OK
  FALLA
  // Fase soporte-moto-carro (Slice 2): valores del estado triestado para
  // ítems de fluidos (tipoRespuesta = TRIESTADO). Agregados de forma
  // aditiva acá porque `ADD VALUE` de Postgres no reescribe nada; el gate
  // que los habilita es `ChecklistItem.tipoRespuesta` (validado en
  // `responderItem` vía lib/inspections/respuesta.ts).
  BUENO
  BAJO
  MALO
}

// Fase soporte-moto-carro: tipo de vehículo que decide qué catálogo de
// checklist se abre (Vehicle.tipoVehiculo) y qué vehículos puede elegir un
// trabajador (User.tipoVehiculo). Ver ADR A1/D3 en el design del cambio, que
// decía que no había FK trabajador→vehículo. REVERTIDO por decisión del
// usuario (2026-09-18): cada trabajador tiene UN único vehículo (relación
// 1:1, `User.vehicleId`) que se crea junto con el usuario; el tipo sigue
// decidiendo el catálogo.
enum TipoVehiculo {
  MOTO
  CARRO
}

// Fase soporte-moto-carro (Slice 2): discrimina si un ChecklistItem acepta
// la respuesta binaria de siempre (OK/FALLA) o el triestado de fluidos
// (BUENO/BAJO/MALO). Creado en este slice (junto con el resto de los enums
// nuevos) pero sin ningún campo que lo use todavía — `ChecklistItem.tipoRespuesta`
// llega en el slice siguiente; ver nota de RespuestaChecklist arriba.
enum TipoRespuestaItem {
  BINARIO
  TRIESTADO
}

// Fase soporte-moto-carro (Slice 3): tipo de foto diaria obligatoria por
// inspección (lateral y placa del vehículo), independiente del resultado
// del checklist. Consumido por el modelo `FotoInspeccion` (más abajo).
enum TipoFotoInspeccion {
  LATERAL
  PLACA
}

// Fase C: tipo de novedad, alineado a las convenciones de dibujo del
// formato oficial FO-SVS-23 (sección de daños de carrocería) más las
// categorías generales de novedad del resto del checklist. Los primeros 7
// valores son los auditados contra el formato físico. VENCIDO se agregó
// después, específico para "Documentación" (SOAT/licencia/etc. vencidos no
// entran en ninguno de los otros 7) — ver TIPOS_NOVEDAD_DOCUMENTO en
// lib/inspections/novedad-tipo.ts.
enum TipoNovedad {
  RAYON
  RAYON_FUERTE
  ABOLLADURA
  GOLPE_FUERTE
  FALLA
  DANO
  FALTANTE
  VENCIDO
}

// Fase D: las dos líneas de firma del formato oficial FO-SVS-23 ("NOMBRE Y
// FIRMA DEL CONDUCTOR" / "NOMBRE Y FIRMA DEL SUPERVISOR").
enum TipoFirma {
  CONDUCTOR
  SUPERVISOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Número de documento de identidad (cédula), mostrado junto a la firma
  // manuscrita en el detalle y el PDF para trazabilidad — pedido del dueño
  // de producto. Opcional: los usuarios anteriores a este campo (legacy,
  // creados vía prisma/seed.ts) no la tienen, así que forzarlo NOT NULL sería
  // peor; se exige solo en el alta de un TRABAJADOR (lib/admin/user-actions.ts)
  // y se completa desde el panel de Administrador.
  cedula String?

  // Teléfono y cargo: datos administrativos pedidos para el panel de
  // Administrador (app/(admin)/admin/usuarios) — opcionales por el mismo
  // motivo que `cedula` (se completan/editan desde el panel, no hay forma
  // de forzarlos retroactivamente en los usuarios ya existentes).
  telefono String?
  cargo    String?

  // Fase soporte-moto-carro: tipo de vehículo que el trabajador está
  // habilitado a operar (MOTO/CARRO). Debe coincidir con el tipo de su
  // vehículo (`vehicleId`, más abajo) para poder iniciar una inspección — se
  // re-valida en `iniciarInspeccion`. Nullable:
  // usuarios legacy (creados antes de este cambio) se muestran como
  // "pendiente de asignación" en el panel de Administrador en vez de
  // bloquearse — se completa desde ahí, igual que `cedula`/`cargo`.
  tipoVehiculo TipoVehiculo?

  // Vehículo único del trabajador (relación 1:1). Reemplaza a propósito la
  // decisión previa "no hay FK trabajador→vehículo": el usuario decidió el
  // 2026-09-18 que cada TRABAJADOR tiene UN vehículo, creado junto con el
  // usuario en el alta (ya no hay un módulo de vehículos aparte). `@unique`
  // garantiza el 1:1. Nullable por la regla D4 (usuarios legacy sin vehículo
  // siguen existiendo y se completan desde su hoja de vida); el vehículo se
  // exige solo en el alta de un TRABAJADOR (capa de server actions), nunca
  // con NOT NULL.
  vehicleId String?  @unique
  vehicle   Vehicle? @relation("VehiculoAsignado", fields: [vehicleId], references: [id])

  // Puesto asignado (dato administrativo, distinto de `cargo`): pedido
  // explícito del dueño de producto para el panel de Administrador. Mismo
  // motivo de nullability que el resto de los campos administrativos de
  // este modelo.
  puestoAsignado String?

  // Datos del conductor (formato oficial FO-SVS-23): el conductor siempre es
  // un usuario del sistema (rol TRABAJADOR, confirmado por el dueño de
  // producto), por eso vive acá y no en una entidad nueva. No es exclusivo
  // del rol TRABAJADOR a nivel de schema (no hay forma de restringir por
  // enum en Prisma), pero conceptualmente solo aplica a conductores. El
  // vencimiento del pase se eliminó del sistema el 2026-09-18 (decisión del
  // usuario).
  conductorActivo Boolean @default(true)

  inspectionsAsWorker     Inspection[] @relation("InspectionWorker")
  inspectionsAsSupervisor Inspection[] @relation("InspectionSupervisor")
  inspectionsAsConductor  Inspection[] @relation("InspectionConductor")
  auditLogs               AuditLog[]
  firmas                  Firma[]
  configuracionesActualizadas AppSetting[]

  @@index([role])
}

model Vehicle {
  id        String   @id @default(cuid())
  placa     String   @unique
  tipo      String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Vencimiento de la revisión tecnicomecánica (formato oficial FO-SVS-23,
  // encabezado del formulario).
  fechaVencimientoTecnicomecanica DateTime?

  // Fase soporte-moto-carro: tipo de vehículo (MOTO/CARRO), decide qué
  // catálogo de checklist se abre (getChecklistCatalog). Backfill a MOTO
  // para todos los vehículos existentes en la misma migración que agrega la
  // columna (el sistema fue moto-only hasta este cambio) — ver
  // prisma/migrations/*_tipo_vehiculo_hoja_de_vida/migration.sql. Nullable a
  // nivel de schema por la misma regla D4 que el resto de los campos
  // nuevos (requeridos se validan en la capa de server actions, nunca con
  // NOT NULL), aunque en la práctica todo vehículo queda con valor tras el
  // backfill + la validación del alta de usuario (lib/admin/user-actions.ts).
  tipoVehiculo TipoVehiculo?

  // Hoja de vida del vehículo. Desde 2026-09-18 (decisión del usuario) el
  // vehículo se crea y edita desde el usuario TRABAJADOR dueño (1:1,
  // `User.vehicleId`), por SST/Administrador — ya no existe un módulo de
  // vehículos aparte: foto (S3/MinIO, mismo patrón que Photo/Firma — solo se
  // guarda el s3Key, nunca una URL pública permanente) + datos de
  // identificación + vencimientos de documentos. Todo nullable a nivel de
  // schema (D4); el alta del trabajador exige photo + estos campos, la
  // edición los deja editables sin volver a exigir la foto. Número de motor,
  // número de chasis y vencimiento de tarjeta de tránsito se eliminaron del
  // sistema el 2026-09-18 (decisión del usuario).
  fotoS3Key String?
  marca     String?
  modelo    String?
  color     String?

  fechaVencimientoSoat DateTime?

  inspections Inspection[]
  // Trabajador dueño de este vehículo (1:1, ver `User.vehicleId`). Null en
  // vehículos legacy que ningún usuario reclama.
  conductor User? @relation("VehiculoAsignado")
}

// Registro inmutable: no se agrega deletedAt ni mutation de borrado. Los
// errores se corrigen con nuevos estados/observaciones, nunca eliminando.
model Inspection {
  id            String            @id @default(cuid())
  workerId      String
  worker        User              @relation("InspectionWorker", fields: [workerId], references: [id])
  // Conductor responsable de la unidad (formato oficial FO-SVS-23), separado
  // de `workerId` ("quién hace la inspección") aunque en el flujo normal sea
  // la misma persona — ver `iniciarInspeccion` en lib/inspections/actions.ts,
  // que hoy setea `conductorId = workerId` automáticamente por defecto.
  conductorId   String
  conductor     User              @relation("InspectionConductor", fields: [conductorId], references: [id])
  vehicleId     String
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id])
  supervisorId  String?
  supervisor    User?             @relation("InspectionSupervisor", fields: [supervisorId], references: [id])
  status        InspectionStatus  @default(EN_PROCESO)

  // Todos los timestamps siguientes se asignan con la hora del servidor
  // (nunca con un valor enviado por el cliente).
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  reviewedAt    DateTime?

  // Observaciones que deja el Supervisor al aprobar o rechazar (Fase 3).
  observacionesSupervisor String?

  // Medida directa de la inspección (Fase 2): no es un check de
  // conforme/no-conforme, es un valor medible que el trabajador reporta una
  // sola vez por inspección — por eso vive acá como campo y NO como
  // ChecklistItem. Ver `registrarKilometraje` en lib/inspections/actions.ts.
  kilometraje       Int?

  // Resultado final reportado por el trabajador (sección 13 del brief). Si
  // `puedeOperar` es false, `justificacionNoOperar` es obligatoria (validado
  // en `registrarResultado`, lib/inspections/actions.ts).
  puedeOperar             Boolean?
  justificacionNoOperar   String?

  // Fase soporte-moto-carro (Slice 3, A6): declaración de estado del
  // conductor — 3 preguntas sí/no del formato, respondidas de a una y
  // corregibles mientras la inspección siga EN_PROCESO
  // (`registrarRespuestaEstadoConductor`, lib/inspections/actions.ts). Una
  // respuesta "preocupante" NO bloquea el envío ni transiciona el estado —
  // solo se refleja como advertencia derivada para el Supervisor (ver
  // `requiereAtencionEstadoConductor`, lib/inspections/estado-conductor.ts,
  // función pura, no un flag guardado: evita que quede desactivado si algún
  // día se permitiera editar la declaración). El Supervisor sigue siendo el
  // único que decide aprobar/rechazar (D8). Nullable (D4): se exigen
  // completas (las 3 no-null) recién en `enviarInspeccion`.
  tomaMedicamentos    Boolean?
  condicionesAptas    Boolean?
  consumioAlcohol     Boolean?
  declaracionEstadoAt DateTime?

  respuestas    InspectionItemResponse[]
  novedades     Novedad[]
  firmas        Firma[]
  fotos         FotoInspeccion[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([workerId])
  @@index([conductorId])
  @@index([vehicleId])
  @@index([status])
}

// Catálogo de categorías del checklist, alineado al formato oficial
// FO-SVS-23 (columna MOTOS): "Inspección Visual" y "Documentación". Se
// pueblan vía prisma/seed.ts, no se crean desde la UI en esta fase.
model ChecklistCategory {
  id        String          @id @default(cuid())
  nombre    String          @unique
  orden     Int
  items     ChecklistItem[]

  @@index([orden])
}

// Ítem individual del checklist (ej: "Luces Altas y Bajas", "SOAT").
model ChecklistItem {
  id          String                    @id @default(cuid())
  categoryId  String
  category    ChecklistCategory         @relation(fields: [categoryId], references: [id])
  nombre      String
  orden       Int
  // Rutas públicas (bajo /public/checklist/) de las fotos de referencia que
  // se muestran al trabajador para que asocie visualmente sobre qué parte de
  // la moto se le está preguntando (feedback del dueño de producto). Galería
  // (0 a N imágenes, ej. "Direccionales y Estacionarias" usa 2) en vez de una
  // sola imagen. Vacío para los ítems de Documentación, que no tienen foto de
  // referencia; mientras un archivo no exista, la UI cae a un placeholder
  // neutro (ver GaleriaReferencia/ImagenReferencia en
  // app/(worker)/inspecciones/_components).
  imagenesUrl String[]                  @default([])
  // Imágenes propias para CARRO en las preguntas compartidas con moto
  // (Espejos, Frenos, fluidos): si el vehículo es CARRO y esta lista no está
  // vacía, reemplaza a `imagenesUrl` (ver lib/inspections/imagenes.ts). Los
  // ítems exclusivos de CARRO guardan sus imágenes en `imagenesUrl`.
  imagenesCarroUrl String[]             @default([])
  // Único ítem del catálogo (hoy: "Rayones") que, cuando queda en FALLA,
  // pide al trabajador indicar por escrito dónde está lo que reporta, con
  // un selector de tipo acotado a daños de carrocería en vez de la pantalla
  // de novedad genérica. Si el ítem queda OK no se pide nada — no hay nada
  // que ubicar. Se modela como flag simple en vez de una tabla/columna
  // nueva porque reutiliza el campo `observacion` ya existente en
  // InspectionItemResponse; ver UI en
  // app/(worker)/inspecciones/[id]/checklist/[itemId]/page.tsx.
  pideUbicacion Boolean                 @default(false)

  // Fase soporte-moto-carro (Slice 2): mismo patrón de branching que
  // `Vehicle.tipoVehiculo`/`User.tipoVehiculo` (A1) — null significa "aplica
  // a ambos tipos" (ej: Documentación, Fluidos), un valor puntual restringe
  // el ítem a MOTO o CARRO (ej: Casco, Cinturones de seguridad). Filtrado en
  // `getChecklistCatalog` (lib/inspections/queries.ts).
  tipoVehiculo TipoVehiculo?

  // Fase soporte-moto-carro (Slice 2, A2): discrimina si este ítem acepta la
  // respuesta binaria de siempre (OK/FALLA) o el triestado de fluidos
  // (BUENO/BAJO/MALO). `@default(BINARIO)` preserva el comportamiento
  // existente para todo ítem que no lo declare explícitamente. Validado en
  // `responderItem` vía `lib/inspections/respuesta.ts`.
  tipoRespuesta TipoRespuestaItem      @default(BINARIO)

  respuestas  InspectionItemResponse[]

  @@index([categoryId])
}

// Respuesta de un trabajador a un ChecklistItem dentro de una inspección
// puntual. Único por (inspectionId, checklistItemId): un ítem se responde
// una sola vez por inspección (se puede actualizar mientras la inspección
// sigue EN_PROCESO, nunca después de enviada).
model InspectionItemResponse {
  id              String              @id @default(cuid())
  inspectionId    String
  inspection      Inspection          @relation(fields: [inspectionId], references: [id])
  checklistItemId String
  checklistItem   ChecklistItem       @relation(fields: [checklistItemId], references: [id])
  valor           RespuestaChecklist
  observacion     String?
  // Generado por el servidor (`now()`), nunca recibido del cliente.
  createdAt       DateTime            @default(now())

  novedad         Novedad?

  @@unique([inspectionId, checklistItemId])
  @@index([inspectionId])
}

// Novedad reportada cuando un ítem queda en FALLA (caso principal, ligada
// a `inspectionItemResponseId`). También admite una novedad general de la
// inspección (no ligada a un ítem puntual) dejando `inspectionItemResponseId`
// en null pero conservando `inspectionId` — así nunca queda huérfana de la
// inspección a la que pertenece. Esta fase solo crea el caso principal
// (ligada a ítem) desde `responderItem`; el caso general queda modelado para
// una fase futura. Ver duda de modelado documentada en el reporte de Fase 2.
model Novedad {
  id                        String                   @id @default(cuid())
  inspectionId              String
  inspection                Inspection               @relation(fields: [inspectionId], references: [id])
  inspectionItemResponseId  String?                  @unique
  inspectionItemResponse    InspectionItemResponse?  @relation(fields: [inspectionItemResponseId], references: [id])
  descripcion               String
  tipo                      TipoNovedad
  // Campo "¿Dónde?" del formato oficial FO-SVS-23: descripción de la
  // ubicación física del daño, separada de `descripcion` (texto libre que
  // explica QUÉ pasó). Para el ítem "Rayones" (`ChecklistItem.pideUbicacion`)
  // el valor ya capturado en esa pantalla especial termina acá, sin pedirlo
  // dos veces — ver lib/inspections/actions.ts (`responderItem`).
  ubicacion                 String?
  createdAt                 DateTime                 @default(now())

  photos                    Photo[]

  @@index([inspectionId])
}

// Las fotos SOLO se relacionan a una Novedad (nunca sueltas, sección 11 del
// brief). Se guarda únicamente el `s3Key`: nunca una URL pública permanente.
// Las URLs de lectura se firman on-demand (ver lib/storage/s3.ts) cuando se
// necesite mostrar la foto (ej: futura pantalla de aprobación del
// supervisor).
model Photo {
  id         String   @id @default(cuid())
  novedadId  String
  novedad    Novedad  @relation(fields: [novedadId], references: [id])
  s3Key      String
  createdAt  DateTime @default(now())

  @@index([novedadId])
}

// Firma manuscrita real (Fase D), dibujada con el dedo/mouse en un
// `<canvas>` y subida como PNG a S3 (mismo patrón que `Photo`: solo se
// guarda el `s3Key`, nunca una URL pública permanente). Una por
// inspección y por tipo (CONDUCTOR/SUPERVISOR) — el `@@unique` es la
// garantía real de inmutabilidad: una vez creada, ninguna mutation la
// sobrescribe (ver `guardarFirmaConductor`/`guardarFirmaSupervisor` en
// lib/inspections/firma-actions.ts, que rechazan explícitamente el intento
// de reemplazo antes de tocar la base de datos).
model Firma {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  tipo         TipoFirma
  s3Key        String
  // Generado por el servidor (`now()`), nunca recibido del cliente.
  createdAt    DateTime   @default(now())

  @@unique([inspectionId, tipo])
}

// Foto diaria obligatoria por inspección (lateral y placa del vehículo),
// independiente del resultado del checklist (fase soporte-moto-carro, Slice
// 3, A7). Mismo patrón que `Firma`: inmutable, `@@unique([inspectionId,
// tipo])` — una vez subida, ninguna mutation la reemplaza (ver
// `subirFotoInspeccion`, lib/inspections/foto-actions.ts). Solo se guarda el
// `s3Key`, nunca una URL pública permanente (mismo criterio que
// `Photo`/`Firma`).
model FotoInspeccion {
  id           String             @id @default(cuid())
  inspectionId String
  inspection   Inspection         @relation(fields: [inspectionId], references: [id])
  tipo         TipoFotoInspeccion
  s3Key        String
  // Generado por el servidor (`now()`), nunca recibido del cliente.
  createdAt    DateTime           @default(now())

  @@unique([inspectionId, tipo])
}

// Almacén genérico de configuración editable por un Administrador sin
// redeploy (fase soporte-moto-carro, Slice 4, ADR A5). Se verificó que no
// existía ningún mecanismo de configuración en el proyecto (sin modelo
// Setting/Config, nada en lib/) antes de introducir este modelo — clave/valor
// simples en vez de una tabla con una columna por setting, para no migrar el
// schema cada vez que se agregue una configuración nueva. Primer uso:
// `formato.fechaVigencia` (ver lib/settings/queries.ts), sembrado con un
// placeholder explícito hasta que un Administrador defina la fecha real.
model AppSetting {
  clave     String   @id
  valor     String
  // Generado por Prisma (`@updatedAt`), nunca recibido del cliente — mismo
  // criterio de timestamps del resto del schema.
  updatedAt DateTime @updatedAt

  // Quién hizo el último cambio, para el rastro de auditoría (además del
  // registro en AuditLog vía `logAudit`, ver lib/settings/actions.ts).
  // Nullable: la fila sembrada por el seed no tiene un Administrador autor.
  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  // Timestamp de auditoría generado por el servidor (`now()`), nunca por el cliente.
  createdAt  DateTime @default(now())
  metadata   Json?

  @@index([userId])
  @@index([entityType, entityId])
}
