# Copiar este archivo a .env y completar con valores reales.

# Cadena de conexion a PostgreSQL.
DATABASE_URL="postgresql://user:password@localhost:5432/preoperacional_seguridad_vial"

# Secreto usado por NextAuth para firmar JWT/cookies. Generar uno con:
#   npx auth secret
# o:
#   openssl rand -base64 32
NEXTAUTH_SECRET="reemplazar-por-un-secreto-aleatorio"

# URL base de la app (usada por NextAuth para callbacks).
NEXTAUTH_URL="http://localhost:3000"
